// SmartCool configuration for atlas (ROG Crosshair X870E Hero)
// Chip: nct6799 (loaded via nct6775 kernel module)
// Sensors: k10temp (CPU Tctl), nct6799 (SYSTIN, CPUTIN)
// Fans: pwm2 = CPU cooler, pwm1 = case fan group, pwm3 = top fan
Config(
    poll_interval_ms: 2000,

    derivative: DerivativeConfig(
        window_size: 10,
        boost_threshold: 2.0,
        decay_rate: 0.5,
    ),

    sensors: [
        SensorConfig(
            name: "cpu",
            hwmon: "k10temp",
            index: 1,
        ),
        SensorConfig(
            name: "board_sys",
            hwmon: "nct6799",
            index: 1,
        ),
        SensorConfig(
            name: "board_cpu",
            hwmon: "nct6799",
            index: 2,
        ),
    ],

    tuning: TuningConfig(
        ewma_span: 20,
        ccf_buffer_size: 120,
        ccf_max_lag: 30,
        step_threshold: 15,
        response_window: 60,
        regression_min_samples: 60,
    ),

    fans: [
        // CPU cooler — aggressive curve
        FanConfig(
            name: "cpu_cooler",
            hwmon: "nct6799",
            pwm_index: 2,
            sensors: ["cpu", "board_cpu"],
            curve: [
                CurvePoint(temp: 45, pwm: 30),
                CurvePoint(temp: 55, pwm: 80),
                CurvePoint(temp: 65, pwm: 140),
                CurvePoint(temp: 75, pwm: 200),
                CurvePoint(temp: 85, pwm: 255),
            ],
        ),
        // Case fan group (front + top + rear on splitter)
        FanConfig(
            name: "case_group",
            hwmon: "nct6799",
            pwm_index: 1,
            sensors: ["cpu", "board_sys"],
            curve: [
                CurvePoint(temp: 45, pwm: 20),
                CurvePoint(temp: 55, pwm: 40),
                CurvePoint(temp: 65, pwm: 80),
                CurvePoint(temp: 75, pwm: 130),
                CurvePoint(temp: 85, pwm: 200),
            ],
        ),
        // Top fan (new)
        FanConfig(
            name: "top_fan",
            hwmon: "nct6799",
            pwm_index: 3,
            sensors: ["cpu", "board_sys"],
            curve: [
                CurvePoint(temp: 45, pwm: 20),
                CurvePoint(temp: 55, pwm: 40),
                CurvePoint(temp: 65, pwm: 80),
                CurvePoint(temp: 75, pwm: 130),
                CurvePoint(temp: 85, pwm: 200),
            ],
        ),
    ],
)
