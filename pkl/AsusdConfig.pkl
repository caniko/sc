class FanCurve {
  fan: "CPU" | "GPU" | "MID"
  temp: Listing<UInt>
  pwm: Listing<UInt>
  enabled: Boolean = true
}

class Profile {
  name: "balanced" | "performance" | "quiet" | "low_power" | "custom"
  curves: Listing<FanCurve>
}

profiles: Listing<Profile>

/// Laptop mode: per-fan temperature (°C) through which the fan stays stopped.
laptop_fan_stop_c: Mapping<"CPU" | "GPU" | "MID", UInt> = new {}
