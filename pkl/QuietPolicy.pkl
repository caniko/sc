// Firmware fan control stays with asusd. This supervisor reduces heat before
// the emergency curve segment and holds recovery until temperatures settle.
class Envelope {
  name: "quiet" | "balanced" | "performance"
  cpu_pwm_ceiling: UInt8
  gpu_pwm_ceiling: UInt8
  cpu_ppt: Listing<Int>
  gpu_clock_mhz: UInt
}

profiles: Listing<Envelope>
qualification_id: String
class HardwareIdentity {
  product: String
  bios: String
  board: String
  kernel: String
  nvidia_driver: String
  gpu_devices: Listing<String>
}
hardware: HardwareIdentity
gpu_pci_id: String
energy_path: String = "/sys/class/powercap/intel-rapl:0"
cpu_soft_c: Float = 80.0
gpu_soft_c: Float = 72.0
cpu_emergency_c: Float = 90.0
gpu_emergency_c: Float = 80.0
cpu_emergency_band_c: Float = 5.0
gpu_emergency_band_c: Float = 2.0
recovery_hysteresis_c: Float = 5.0
recovery_seconds: UInt = 30
gpu_reduced_clock_mhz: UInt = 600
cpu_start_pwm: UInt8
gpu_start_pwm: UInt8
