class DerivativeConfig {
  window_size: UInt
  boost_threshold: Number
  decay_rate: Number
}

class TuningConfig {
  ewma_span: UInt = 20
  ccf_buffer_size: UInt = 120
  ccf_max_lag: UInt = 30
  step_threshold: UInt = 15
  response_window: UInt = 60
  regression_min_samples: UInt = 60
}

class SensorConfig {
  name: String
  hwmon: String
  index: UInt
  hwmon_instance: UInt? = null
}

class FanTopology {
  position: "front" | "rear" | "top" | "bottom" | "side" | "cpu_cooler" | "gpu_cooler"
  direction: "intake" | "exhaust"
  group: String? = null
}

class CurvePoint {
  temp: UInt
  pwm: UInt
}

class FanConfig {
  name: String
  hwmon: String
  pwm_index: UInt
  hwmon_instance: UInt? = null
  topology: FanTopology
  sensors: Listing<String>
  curve: Listing<CurvePoint>
  sensor_curves: Listing<SensorCurve> = new {}
}

class SensorCurve {
  sensor: String
  curve: Listing<CurvePoint>
}

class NvidiaCurvePoint {
  temp: UInt
  percent: UInt(isBetween(0, 100))
}

class NvidiaFan {
  index: UInt
  disabled: Boolean = false
  curve: Listing<NvidiaCurvePoint> = new {}
}

class NvidiaGpu {
  /// PCI bus id ("0000:01:00.0") or NVML device index ("0").
  device: String
  hysteresis: UInt = 0
  fans: Listing<NvidiaFan>
}

poll_interval_ms: UInt
derivative: DerivativeConfig
sensors: Listing<SensorConfig> = new {}
fans: Listing<FanConfig> = new {}
nvidia: Listing<NvidiaGpu> = new {}
tuning: TuningConfig = new {}
/// °C a falling sensor reading must drop below its held value before fan
/// curves follow it down.
hysteresis: UInt = 0
